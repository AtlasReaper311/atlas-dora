{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlas-dora",
  "main": "src/public-boundary.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "kv_namespaces": [
    {
      "binding": "DORA_CACHE",
      "id": "a0c92692d5c142b38b3196c13f346d21"
    }
  ],
  "routes": [
    {
      "pattern": "api.atlas-systems.uk/dora/*",
      "zone_id": "8ba6350a78c988447c111048b125f917"
    }
  ],
  "services": [
    {
      "binding": "ATLAS_NOTIFY",
      "service": "atlas-notify"
    },
    {
      "binding": "ATLAS_BLACKBOX",
      "service": "atlas-blackbox"
    },
    {
      "binding": "DEPLOY_WATCH",
      "service": "deploy-watch"
    },
    {
      "binding": "ATLAS_API_PUBLIC",
      "service": "atlas-api-public"
    }
  ]
}
